<script>
    function toggleDropdown() {
        const dropdown = document.getElementById("dropdownContent");
        dropdown.style.display = dropdown.style.display === "block" ? "none" : "block";
    }
    
    function updateGuestCount(type, change) {
        const input = document.getElementById(type);
        let value = parseInt(input.value);
        
        value += change;
        if (value < 0) value = 0;
        
        input.value = value;
        updateSummary();
    }
    
    function updateSummary() {
        const adults = document.getElementById("adults").value;
        const children = document.getElementById("children").value;
        const rooms = document.getElementById("rooms").value;
        
        const summaryText = `${adults} adult${adults > 1 ? 's' : ''} · ${children} child${children > 1 ? 'ren' : ''} · ${rooms} room${rooms > 1 ? 's' : ''}`;
        document.getElementById("guestSummary").value = summaryText;
    }
    
    // Close the dropdown if the user clicks outside of it
    window.onclick = function(event) {
        const dropdown = document.getElementById("dropdownContent");
        const summaryInput = document.getElementById("guestSummary");
    
        if (!summaryInput.contains(event.target) && !dropdown.contains(event.target)) {
            dropdown.style.display = "none";
        }
    }
</script>
