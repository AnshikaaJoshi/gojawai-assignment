<!-- Template Javascript -->
    <script src="js/main.js"></script>
    <script>
        const toggleBtn = document.getElementById("toggleBtn");
        const moreText = document.querySelector(".more-text");

        toggleBtn.addEventListener("click", function () {
            if (moreText.style.display === "none" || moreText.style.display === "") {
                moreText.style.display = "inline";
                toggleBtn.textContent = "Read Less";
            } else {
                moreText.style.display = "none";
                toggleBtn.textContent = "Read More";
            }
        });
    </script>

    <script>
        // FAQ Toggle
        document.querySelectorAll('.faq-question').forEach(q => {
            q.addEventListener('click', () => {
                const answer = q.nextElementSibling;
                answer.style.display = answer.style.display === 'block' ? 'none' : 'block';
                q.querySelector('i').classList.toggle('fa-chevron-up');
                q.querySelector('i').classList.toggle('fa-chevron-down');
            });
        });


        const prevBtn = document.querySelector('.arrow.prev');
        const nextBtn = document.querySelector('.arrow.next');
        const blogCardList = document.querySelector('.blog-card-list');

        let scrollPosition = 0;
        const cardWidth = 215;

        nextBtn.addEventListener('click', () => {
            if (scrollPosition > -(blogCardList.scrollWidth - blogCardList.parentElement.clientWidth)) {
                scrollPosition -= cardWidth;
                blogCardList.style.transform = `translateX(${scrollPosition}px)`;
            }
        });

        prevBtn.addEventListener('click', () => {
            if (scrollPosition < 0) {
                scrollPosition += cardWidth;
                blogCardList.style.transform = `translateX(${scrollPosition}px)`;
            }
        });
    </script>    

    <script>
        var swiper = new Swiper(".mySwiper", {
            loop: true,
            navigation: {
                nextEl: ".swiper-button-next",
                prevEl: ".swiper-button-prev",
            },

        });
    </script>

    <!-- tabs-sscript -->
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const tabs = document.querySelectorAll(".tab");
            const contents = document.querySelectorAll(".tab-content");

            tabs.forEach((tab, index) => {
                tab.addEventListener("click", () => {
                    tabs.forEach(t => t.classList.remove("active"));
                    contents.forEach(c => c.classList.remove("active"));

                    tab.classList.add("active");
                    contents[index].classList.add("active");
                });
            });
        });
    </script>

    <!-- blog-post -->
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const swiper = new Swiper(".blog-card-list-wrapper", {
                slidesPerView: 5.5,
                // spaceBetween: 10,
                navigation: {
                    nextEl: ".arrow.next",
                    prevEl: ".arrow.prev",
                },
                loop: false, // set true if you want infinite scroll
                breakpoints: {
                    320: { slidesPerView: 1.2, },
                    576: { slidesPerView: 2.2, },
                    768: { slidesPerView: 3.2, },
                    1024: { slidesPerView: 4.5, },
                },
            });
        });



        function equalizeHeights() {
            let cards = document.querySelectorAll('.blog-card');
            let maxHeight = 0;

            cards.forEach(card => {
                card.style.height = "auto"; // reset first
                if (card.offsetHeight > maxHeight) {
                    maxHeight = card.offsetHeight;
                }
            });

            cards.forEach(card => {
                card.style.height = maxHeight + "px";
            });
        }

        // Run after Swiper init
        document.addEventListener("DOMContentLoaded", () => {
            equalizeHeights();
            window.addEventListener("resize", equalizeHeights);
        });

    </script>


    <!-- cusstomer-blog -->

    <script>
        var swiper = new Swiper(".customerSwiper", {
            slidesPerView: 3,
            spaceBetween: 20,
            navigation: {
                nextEl: ".swiper-button-next",
                prevEl: ".swiper-button-prev",
            },
            loop: false,
            breakpoints: {
                320: { slidesPerView: 1 },
                576: { slidesPerView: 2 },
                768: { slidesPerView: 2 },
                1024: { slidesPerView: 3 }
            }
        });
    </script>

    <!-- modal -->
    <script>
        function formatCountry(country) {
            if (!country.id) {
                return country.text;
            }
            const flagUrl = $(country.element).attr("data-flag");
            if (!flagUrl) return country.text;
            return $('<span><img src="' + flagUrl + '"/> ' + country.text + '</span>');
        }

        $("#countrySelect").select2({
            templateResult: formatCountry,
            templateSelection: formatCountry,
            placeholder: "Search Country",
            allowClear: false,
            escapeMarkup: function (m) { return m; } // important for showing HTML
        });
    </script>

    <!-- review-slider -->
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('.review-slider.swiper').forEach(function (wrap) {
                new Swiper(wrap, {
                    slidesPerView: 1.8,
                    //   spaceBetween: 20,
                    loop: true,
                    navigation: {
                        nextEl: wrap.querySelector('.next'),
                        prevEl: wrap.querySelector('.prev'),
                    },
                    breakpoints: {
                        0: { slidesPerView: 1.1, },
                        576: { slidesPerView: 1.6, },
                        768: { slidesPerView: 2, },
                        1024: { slidesPerView: 1.8, }
                    }
                });
            });
        });
    </script>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            document.querySelectorAll('.slider-wrapper').forEach(wrapper => {
                const container = wrapper.querySelector('.card-slider.swiper');
                const prev = wrapper.querySelector('.slide-arrow.prev');
                const next = wrapper.querySelector('.slide-arrow.next');

                const sw = new Swiper(container, {
                    slidesPerView: 1.2,          // mobile
                    spaceBetween: 16,
                    loop: false,
                    navigation: { prevEl: prev, nextEl: next },
                    breakpoints: {
                        576: { slidesPerView: 2 },
                        992: { slidesPerView: 2.5 },  // “2.5” visible on desktop
                        1200: { slidesPerView: 3 }
                    },
                    observer: true,
                    observeParents: true,
                });

                // If used inside Bootstrap tabs/collapse, update when shown
                document.querySelectorAll('[data-bs-toggle="tab"]').forEach(t =>
                    t.addEventListener('shown.bs.tab', () => sw.update())
                );
                document.querySelectorAll('.accordion-collapse').forEach(c =>
                    c.addEventListener('shown.bs.collapse', () => sw.update())
                );
            });
        });
    </script>

    <!-- lightbox -->

    <script>
        lightGallery(document.getElementById('lightgallery'), {
            plugins: [lgThumbnail, lgZoom],
            speed: 500,
            thumbnail: true,   // ✅ enable bottom thumbnail strip
            showThumbByDefault: true,
            download: false,   // hide download button
            fullScreen: true,
            counter: true
        });
    </script>
    <script>
        const gallery = document.querySelectorAll("#lightgallery a");
        if (gallery.length > 3) {
            gallery[2].classList.add("more"); // add overlay on 3rd image
        }
    </script>

    <!-- select-flag -->
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const toggle = document.getElementById("selectedCountry");
            const menu = document.querySelector(".dropdown-menu");
            const items = document.querySelectorAll(".dropdown-menu li");

            toggle.addEventListener("click", () => {
                menu.style.display = menu.style.display === "block" ? "none" : "block";
            });

            items.forEach(item => {
                item.addEventListener("click", () => {
                    const flag = item.getAttribute("data-flag");
                    const text = item.innerText;
                    toggle.innerHTML = `<img src="${flag}" alt="flag"> ${text}`;
                    menu.style.display = "none";
                });
            });

            // Close dropdown if click outside
            document.addEventListener("click", (e) => {
                if (!e.target.closest(".custom-dropdown")) {
                    menu.style.display = "none";
                }
            });
        });
    </script>
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const hamburgerBtn = document.getElementById("hamburgerBtn");
            const sideMenu = document.getElementById("sideMenu");
            const closeBtn = document.getElementById("closeBtn");

            hamburgerBtn.addEventListener("click", () => {
                sideMenu.classList.add("active");
            });

            closeBtn.addEventListener("click", () => {
                sideMenu.classList.remove("active");
            });

            // Close if clicked outside menu
            document.addEventListener("click", (e) => {
                if (!sideMenu.contains(e.target) && !hamburgerBtn.contains(e.target)) {
                    sideMenu.classList.remove("active");
                }
            });
        });
    </script>

    <!-- show-hide-detail -->
    <script>
        document.querySelectorAll('.details-toggle').forEach(toggle => {
            toggle.addEventListener('click', function () {
                const details = this.nextElementSibling;

                if (details.style.display === "block") {
                    details.style.display = "none";
                    this.textContent = "Show Details";
                } else {
                    details.style.display = "block";
                    this.textContent = "Hide Details";
                }
            });
        });
    </script>


    <script>
        document.querySelectorAll('.accordion-button').forEach(button => {
            button.addEventListener('click', function () {
                const icon = this.querySelector('.toggle-icon');

                // Wait a little so aria-expanded updates correctly
                setTimeout(() => {
                    if (this.getAttribute("aria-expanded") === "true") {
                        icon.classList.add("rotate");
                    } else {
                        icon.classList.remove("rotate");
                    }
                }, 150);
            });
        });
    </script>
    <script>
			/* make equal height */
	       	function resizeequalheight(){ 
	       		equalHeight($(".blog-content"));  
				
	       	} 
			
			function equalHeight(group) { 
				tallest = 0; group.height(''); 
				group.each(function() { 
					thisHeight = $(this).height(); 
					if(thisHeight > tallest) { 
						tallest = thisHeight; 
					} 
				}); 
				group.height(tallest); 
			} 
			
			function setHeight(group) { 
				max_height = 260; 
				group.height('');  
				group.each(function() { 
					thisHeight = $(this).height(); 
					if(thisHeight > tallest) { 
						tallest = thisHeight; 
					} 
				}); 
				if( tallest < max_height ){
					group.height(tallest); 
				}
				else{
					group.height(max_height); 
				}
			} 
			$(function(){ 
				$(window).resize(function() { 
					setTimeout('resizeequalheight()',1000) 
				}); 
			});	
			
			$(window).on('load', function() {
				setTimeout('resizeequalheight()',1000);
			});
	</script>
	


	
